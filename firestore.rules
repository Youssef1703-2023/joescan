rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
       return request.auth != null;
    }
    
    function isOwner(userId) {
       return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Admin = an explicit custom claim (preferred; set with scripts/set-admin-claim.js),
    // or the owner's email but only when Firebase has actually verified it — an
    // unverified same-email signup from another provider must not inherit admin.
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (request.auth.token.email == 'joetech.dev.systems@gmail.com'
          && request.auth.token.email_verified == true)
      );
    }
    
    function hasRequiredFields(fields) {
       return request.resource.data.keys().hasAll(fields);
    }
    
    function validStringOrNull(field) {
       return !(field in request.resource.data) ||
         request.resource.data[field] == null ||
         (request.resource.data[field] is string && request.resource.data[field].size() <= 500);
    }
    
    function uidUnchanged() {
       return !('uid' in request.resource.data) ||
         request.resource.data.uid == request.auth.uid;
    }
    
    function uidNotModified() {
       return !('uid' in request.resource.data) ||
         request.resource.data.uid == resource.data.uid;
    }

    function isValidUser() {
      return validStringOrNull('email') && validStringOrNull('name');
    }

    function isValidScan() {
      let data = request.resource.data;
      return hasRequiredFields(['userId']) &&
        data.userId == request.auth.uid;
    }

    function reqOwnerId() { return request.resource.data.userId; }

    function entitlementFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['tier','subscriptionExpiry','tierExpiry',
                 'socTrialUsed','socTrialActivatedAt','upgradedVia']);
    }

    // Allowlist, not denylist: a sensitive field added to the schema later is
    // denied by default instead of being silently writable by the owner.
    // These are exactly the keys the client writes today.
    function userOwnerKeysOk() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(
        ['name','email','username','avatarURL','completedLessons',
         'mfaSecret','mfaSkipped','createdAt','updatedAt']);
    }

    function userCreateKeysOk() {
      return request.resource.data.keys().hasOnly(
        ['uid','email','name','username','avatarURL','tier',
         'completedLessons','createdAt','updatedAt']);
    }

    // Entitlement gate for premium resources. Costs one document read per
    // evaluation, so it is used only on create of a paid-tier resource.
    function tierIsEnterprise() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tier == 'enterprise';
    }

    // ─── Server-side ban predicate (S02) ───
    // A user is banned only when their bannedUsers/{uid} document exists AND
    // has active == true. A missing document means "not banned" (exists() is
    // false), so unbanned users — the overwhelming common case — pass without
    // a second document read. Unban keeps the document with active == false,
    // which also passes. Admins bypass this predicate at every call site so
    // they can administer the platform regardless of their own ban record.
    // Reads/writes are denied for banned users on every product resource
    // below; list queries are denied the same way as single-document reads.
    function isNotBanned() {
      return !exists(/databases/$(database)/documents/bannedUsers/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/bannedUsers/$(request.auth.uid))
          .data.get('active', false) != true;
    }

    // ─── Users ───
    match /users/{userId} {
      allow read: if isAdmin() || (isNotBanned() && isOwner(userId));
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isNotBanned()
        && isValidUser()
        && uidUnchanged()
        && userCreateKeysOk()
        && (!('tier' in request.resource.data) || request.resource.data.tier == 'free');
      allow update: if isAdmin() && isValidUser();
      allow update: if isOwner(userId) && isNotBanned() && isValidUser()
        && userOwnerKeysOk() && entitlementFieldsUnchanged();
      allow delete: if isAdmin();
    }

    // ─── Usernames (unique username registry) ───
    // Per-username `get` must stay public: login resolves a username to an email
    // before the user is authenticated, so the ban predicate (which requires an
    // authenticated caller) cannot apply here. `list` is denied — the documents
    // carry uid + email, so listing would expose every user's address to anyone.
    match /usernames/{usernameId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAuthenticated() && isNotBanned()
        && request.resource.data.keys().hasOnly(['uid','email','username','createdAt'])
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ─── Admin Config (platform settings, feature flags) ───
    match /adminConfig/{configId} {
      allow read: if isAuthenticated() && isNotBanned();
      allow write: if isAdmin();
    }

    // ─── Broadcasts ───
    match /broadcasts/{broadcastId} {
      allow read: if isAuthenticated() && isNotBanned();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ─── Notifications ───
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && isNotBanned() && resource.data.userId == request.auth.uid;
      // The app creates in-app notifications for the signed-in user
      // (NotificationContext); admin fan-out creates them for others.
      allow create: if isAdmin() ||
        (isAuthenticated() && isNotBanned() && request.resource.data.userId == request.auth.uid);
      // Owner may only flip the read flag, not rewrite the content.
      allow update: if isAuthenticated() && isNotBanned() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAuthenticated() && isNotBanned() && resource.data.userId == request.auth.uid;
      allow list: if isAuthenticated() && isNotBanned() && resource.data.userId == request.auth.uid;
    }

    // ─── Promo Codes ───
    match /promoCodes/{codeId} {
      allow get: if isAuthenticated() && isNotBanned();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // ─── Activity Log ───
    match /activityLog/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && isNotBanned()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ─── Banned Users (S02) ───
    // Ban state is a server-side enforcement record, and the `reason` field is
    // sensitive. Non-admins may only `get` their OWN document (the UI ban
    // banner and the Worker's REST ban lookup both depend on this — note it is
    // deliberately NOT gated by isNotBanned(), otherwise a banned user could
    // never retrieve the verdict about themselves). Listing the collection or
    // reading another user's record is admin-only. Absent documents are simply
    // unreadable; this block grants nothing to unauthenticated callers.
    match /bannedUsers/{banUid} {
      allow get: if isAdmin() || isOwner(banUid);
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // ─── Support Tickets ───
    match /supportTickets/{ticketId} {
      allow read: if isAdmin() || (isAuthenticated() && isNotBanned() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && isNotBanned() && request.resource.data.userId == request.auth.uid;
      // The ticket owner may append a reply or close the ticket; everything else
      // is admin-only. Without this the app's own reply button was denied.
      allow update: if isAdmin() ||
        (isAuthenticated() && isNotBanned() && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['replies','status']));
      allow delete: if false;
      allow list: if isAdmin() || (isAuthenticated() && isNotBanned() && resource.data.userId == request.auth.uid);
    }

    // ─── API Keys ───
    // Only a SHA-256 hash and the last 4 characters are ever stored. The raw key
    // is shown to the user once at creation and never persisted, so a future leak
    // of this collection discloses nothing usable.
    match /apiKeys/{keyId} {
      allow read: if isAuthenticated() && isNotBanned() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && isNotBanned()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['userId','email','name','keyHash','last4','createdAt','lastUsed','requestCount'])
        && !('key' in request.resource.data);
      allow update: if false;
      allow delete: if isAuthenticated() && isNotBanned() && resource.data.userId == request.auth.uid;
      allow list: if isAuthenticated() && isNotBanned() && resource.data.userId == request.auth.uid;
    }

    // ─── Scans ───
    match /scans/{scanId} {
      allow read: if isAuthenticated() && isNotBanned() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && isNotBanned() && isValidScan();
      // Scan history is append-only; nothing in the app edits a scan after the
      // fact, and an immutable log is worth more than an editable one.
      allow update: if false;
      allow delete: if isAuthenticated() && isNotBanned() && resource.data.userId == request.auth.uid;
    }

    // ─── Webhooks / SIEM ───
    match /webhooks/{hookId} {
      allow read, delete: if isAuthenticated() && isNotBanned() && resource.data.ownerId == request.auth.uid;
      // Enterprise-only feature: enforce the entitlement here, not just in the UI.
      allow create: if isAuthenticated() && isNotBanned() && request.resource.data.ownerId == request.auth.uid
        && (isAdmin() || tierIsEnterprise());
      allow update: if isAuthenticated() && isNotBanned() && resource.data.ownerId == request.auth.uid;
      allow list: if isAuthenticated() && isNotBanned() && resource.data.ownerId == request.auth.uid;
    }

    // ─── Teams ───
    match /teams/{teamId} {
      allow read, list: if isAuthenticated() && isNotBanned() && resource.data.ownerId == request.auth.uid;
      // Enterprise-only feature: enforce the entitlement here, not just in the UI.
      allow create: if isAuthenticated() && isNotBanned() && request.resource.data.ownerId == request.auth.uid
        && (isAdmin() || tierIsEnterprise());
      allow update, delete: if isAuthenticated() && isNotBanned() && resource.data.ownerId == request.auth.uid;
    }

    // ─── Watchlist ───
    match /watchlist/{itemId} {
      allow read, delete: if isAuthenticated() && isNotBanned() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && isNotBanned()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['userId', 'type', 'value', 'createdAt', 'lastConfirmedAt', 'schedule'])
        && request.resource.data.keys().hasAll(['userId', 'type', 'value'])
        && request.resource.data.type in ['ip', 'domain', 'email', 'phone']
        && request.resource.data.value is string
        && request.resource.data.value.size() > 0
        && request.resource.data.value.size() <= 255
        && (!('schedule' in request.resource.data)
            || (request.resource.data.schedule is map
                && request.resource.data.schedule.keys().hasOnly(['frequency', 'time', 'day'])
                && (!('frequency' in request.resource.data.schedule)
                    || request.resource.data.schedule.frequency in ['daily', 'weekly'])));
      allow update: if isAuthenticated() && isNotBanned()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['value', 'schedule', 'lastConfirmedAt'])
        && (!('value' in request.resource.data)
            || (request.resource.data.value is string
                && request.resource.data.value.size() > 0
                && request.resource.data.value.size() <= 255))
        && (!('schedule' in request.resource.data)
            || (request.resource.data.schedule is map
                && request.resource.data.schedule.keys().hasOnly(['frequency', 'time', 'day'])
                && (!('frequency' in request.resource.data.schedule)
                    || request.resource.data.schedule.frequency in ['daily', 'weekly'])));
    }

    // ─── Notification Preferences ───
    match /notifPrefs/{userId} {
      allow read, write: if isAuthenticated() && isNotBanned() && request.auth.uid == userId;
    }

    // ─── Referrals ───
    match /referrals/{userId} {
      allow read: if isAuthenticated() && isNotBanned();
      allow create: if isAuthenticated() && isNotBanned() && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.referralCount == 0
        && request.resource.data.claimedTiers.size() == 0;
      allow delete: if isAdmin();
      // Owner: everything except the privileged counters (unchanged from a95ff15).
      allow update: if isAuthenticated() && isNotBanned() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['referralCount','claimedTiers','userId']);
      // Admin: may move the counters. This is the necessary, narrow exception.
      allow update: if isAdmin();
    }

    // ─── Referral Signups ───
    match /referralSignups/{signupId} {
      allow read: if isAdmin() || (isAuthenticated() && isNotBanned() && resource.data.referrerUid == request.auth.uid);
      allow create: if isAdmin() && request.resource.data.newUid == signupId;
      allow update, delete: if false;   // markers are permanent
    }

    // ─── Tier Requests ───
    match /tierRequests/{reqId} {
      allow get:  if isAdmin() || (isAuthenticated() && isNotBanned() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || (isAuthenticated() && isNotBanned() && resource.data.userId == request.auth.uid);

      allow create: if isAuthenticated() && isNotBanned()
        && reqId == request.auth.uid + '_' + request.resource.data.kind
        && reqOwnerId() == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.kind in ['soc_trial','referral_reward','subscription']
        && request.resource.data.keys().hasOnly(
             ['userId','kind','status','tier','rewardTier','promoCode','createdAt'])
        && request.resource.data.keys().hasAll(['userId','kind','status','createdAt'])
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 40
        && (!('tier' in request.resource.data)
            || request.resource.data.tier in ['pro','enterprise'])
        && (!('rewardTier' in request.resource.data)
            || request.resource.data.rewardTier in [1,3,5,10])
        && (!('promoCode' in request.resource.data)
            || (request.resource.data.promoCode is string
                && request.resource.data.promoCode.size() <= 32));

      allow update, delete: if isAdmin();
    }

    // ─── Server-only collections ───
    // Nothing in the browser may touch these. The Admin SDK bypasses rules, so a
    // local script or a future backend can still use them.
    match /mfaSecrets/{uid} {
      allow read, write: if false;
    }

    match /aiUsage/{uid} {
      allow read, write: if false;
    }

    match /pendingOrders/{orderId} {
      allow read, write: if false;
    }

    match /rateLimits/{uid} {
      allow read, write: if false;
    }

    // ─── Referral Claims ───
    match /referralClaims/{claimId} {
      allow get:  if isAdmin() || (isAuthenticated() && isNotBanned() && claimId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isAuthenticated() && isNotBanned()
        && claimId == request.auth.uid
        && request.resource.data.keys().hasOnly(['newUid','code','status','createdAt'])
        && request.resource.data.keys().hasAll(['newUid','code','status','createdAt'])
        && request.resource.data.newUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 4
        && request.resource.data.code.size() <= 32
        && request.resource.data.createdAt is string;
      allow update: if isAdmin();
      allow delete: if false;   // deleting would let the user file a second claim
    }
  }
}
