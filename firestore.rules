rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
       return request.auth != null;
    }
    
    function isOwner(userId) {
       return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
       return isAuthenticated() && request.auth.token.email == 'joetech.dev.systems@gmail.com';
    }
    
    function hasRequiredFields(fields) {
       return request.resource.data.keys().hasAll(fields);
    }
    
    function validStringOrNull(field) {
       return !(field in request.resource.data) ||
         request.resource.data[field] == null ||
         (request.resource.data[field] is string && request.resource.data[field].size() <= 500);
    }
    
    function uidUnchanged() {
       return !('uid' in request.resource.data) ||
         request.resource.data.uid == request.auth.uid;
    }
    
    function uidNotModified() {
       return !('uid' in request.resource.data) ||
         request.resource.data.uid == resource.data.uid;
    }

    function isValidUser() {
      return validStringOrNull('email') && validStringOrNull('name');
    }

    function isValidScan() {
      let data = request.resource.data;
      return hasRequiredFields(['userId']) &&
        data.userId == request.auth.uid;
    }

    function reqOwnerId() { return request.resource.data.userId; }

    function entitlementFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['tier','subscriptionExpiry','tierExpiry',
                 'socTrialUsed','socTrialActivatedAt','upgradedVia']);
    }

    // ─── Users ───
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId)
        && isValidUser()
        && uidUnchanged()
        && (!('tier' in request.resource.data) || request.resource.data.tier == 'free')
        && !request.resource.data.keys().hasAny(
             ['subscriptionExpiry','tierExpiry','socTrialUsed','socTrialActivatedAt','upgradedVia']);
      allow update: if isAdmin() && isValidUser();
      allow update: if isOwner(userId) && isValidUser() && entitlementFieldsUnchanged();
      allow delete: if isAdmin();
    }

    // ─── Usernames (unique username registry) ───
    match /usernames/{usernameId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ─── Admin Config (platform settings, feature flags) ───
    match /adminConfig/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── Broadcasts ───
    match /broadcasts/{broadcastId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ─── Notifications ───
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAdmin();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow list: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ─── Promo Codes ───
    match /promoCodes/{codeId} {
      allow get: if isAuthenticated();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // ─── Activity Log ───
    match /activityLog/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ─── Banned Users ───
    match /bannedUsers/{odId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── Support Tickets ───
    match /supportTickets/{ticketId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow list: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // ─── API Keys ───
    match /apiKeys/{keyId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow list: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ─── Scans ───
    match /scans/{scanId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && isValidScan();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && isValidScan() && request.resource.data.userId == resource.data.userId;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ─── Webhooks / SIEM ───
    match /webhooks/{hookId} {
      allow read, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow list: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // ─── Teams ───
    match /teams/{teamId} {
      allow read, list: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // ─── Watchlist ───
    match /watchlist/{itemId} {
      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }

    // ─── Notification Preferences ───
    match /notifPrefs/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // ─── Referrals ───
    match /referrals/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.referralCount == 0
        && request.resource.data.claimedTiers.size() == 0;
      allow delete: if isAdmin();
      // Owner: everything except the privileged counters (unchanged from a95ff15).
      allow update: if isAuthenticated() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['referralCount','claimedTiers','userId']);
      // Admin: may move the counters. This is the necessary, narrow exception.
      allow update: if isAdmin();
    }

    // ─── Referral Signups ───
    match /referralSignups/{signupId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.referrerUid == request.auth.uid);
      allow create: if isAdmin() && request.resource.data.newUid == signupId;
      allow update, delete: if false;   // markers are permanent
    }

    // ─── Tier Requests ───
    match /tierRequests/{reqId} {
      allow get:  if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);

      allow create: if isAuthenticated()
        && reqId == request.auth.uid + '_' + request.resource.data.kind
        && reqOwnerId() == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.kind in ['soc_trial','referral_reward','subscription']
        && request.resource.data.keys().hasOnly(
             ['userId','kind','status','tier','rewardTier','promoCode','createdAt'])
        && request.resource.data.keys().hasAll(['userId','kind','status','createdAt'])
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 40
        && (!('tier' in request.resource.data)
            || request.resource.data.tier in ['pro','enterprise'])
        && (!('rewardTier' in request.resource.data)
            || request.resource.data.rewardTier in [1,3,5,10])
        && (!('promoCode' in request.resource.data)
            || (request.resource.data.promoCode is string
                && request.resource.data.promoCode.size() <= 32));

      allow update, delete: if isAdmin();
    }

    // ─── Referral Claims ───
    match /referralClaims/{claimId} {
      allow get:  if isAdmin() || (isAuthenticated() && claimId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isAuthenticated()
        && claimId == request.auth.uid
        && request.resource.data.keys().hasOnly(['newUid','code','status','createdAt'])
        && request.resource.data.keys().hasAll(['newUid','code','status','createdAt'])
        && request.resource.data.newUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 4
        && request.resource.data.code.size() <= 32
        && request.resource.data.createdAt is string;
      allow update: if isAdmin();
      allow delete: if false;   // deleting would let the user file a second claim
    }
  }
}
