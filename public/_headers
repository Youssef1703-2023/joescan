# JoeScan — Security & caching headers (Cloudflare Pages)
# Applied to all routes.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://joescan-ai-proxy.goet900.workers.dev https://api.groq.com https://openrouter.ai https://api.pwnedpasswords.com https://api.xposedornot.com https://ipapi.co https://freeipapi.com https://ipwho.is https://dns.google https://urlhaus-api.abuse.ch https://internetdb.shodan.io https://api.ipify.org https://api64.ipify.org https://www.google.com https://www.gstatic.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Quota-Note: free-tier

# Hashed assets are immutable — cache for 1 year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Service worker must always revalidate
/sw.js
  Cache-Control: no-cache

# SPA: index.html served for every route via _redirects, never cached long
/index.html
  Cache-Control: public, max-age=0, must-revalidate
