# Cloudflare Worker AI Proxy (deployed from workers/ai-proxy/)
# URL pointing to the deployed Cloudflare Worker (safe in client bundle, not a secret)
VITE_AI_PROXY_URL="https://joescan-ai-proxy.<your-subdomain>.workers.dev"

# Cloudflare Worker Secrets (Set via Wrangler CLI in workers/ai-proxy/):
#   cd workers/ai-proxy
#   wrangler secret put GROQ_API_KEY
#   wrangler secret put OPENROUTER_API_KEY   (OPTIONAL — only if you want the OpenRouter route; Groq serves both the analyzers and the chatbot)
#
# NOTE: Client-side VITE_* AI API keys are deliberately removed to prevent token exfiltration.
# End-users may optionally supply personal API keys in app settings (stored strictly in browser localStorage).

# Optional Development Server / Hosting config
APP_URL="https://joescan.me"

