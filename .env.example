# Backend Cloud Functions Secrets (Google Cloud Secret Manager / Firebase CLI)
# Set via:
#   firebase functions:secrets:set GROQ_API_KEY
#   firebase functions:secrets:set OPENROUTER_API_KEY
#   firebase functions:secrets:set PAYMOB_API_KEY
#   firebase functions:secrets:set PAYMOB_INTEGRATION_ID
#   firebase functions:secrets:set PAYMOB_HMAC_SECRET
#
# NOTE: Client-side VITE_* AI API keys are deliberately removed to prevent token exfiltration.
# End-users may optionally supply personal API keys in the app settings (stored strictly in browser localStorage).

# Optional Development Server / Hosting config
APP_URL="https://joescan.me"
